{
  "name": "@go2asia/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "API Gateway for Go2Asia MVP (Cloudflare Worker)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:ci": "vitest run --config ./vitest.config.ts",
    "clerk:seed-users": "node ./scripts/clerk_seed_users_from_csv.mjs",
    "identity:materialize-verify": "node ./scripts/identity_materialize_verify_batch.mjs",
    "rf:first-batch": "node ./scripts/rf_first_batch_tool_v1.mjs",
    "rf:first-batch:partners": "node ./scripts/rf_first_batch_tool_v1.mjs --step partners",
    "rf:first-batch:offers": "node ./scripts/rf_first_batch_tool_v1.mjs --step offers",
    "rf:first-batch:pro-links": "node ./scripts/rf_first_batch_tool_v1.mjs --step pro-links",
    "rf:first-batch:verify": "node ./scripts/rf_first_batch_tool_v1.mjs --step verify",
    "rf:first-batch:voucher-cases": "node ./scripts/rf_first_batch_tool_v1.mjs --step voucher-cases"
  },
  "dependencies": {
    "@clerk/backend": "^3.0.2",
    "@go2asia/logger": "workspace:*",
    "@go2asia/schemas": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231218.0",
    "@go2asia/config": "workspace:*",
    "@go2asia/identity-core": "workspace:*",
    "@vitest/coverage-v8": "^1.6.1",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0",
    "wrangler": "^3.19.0"
  }
}
