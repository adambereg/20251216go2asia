{
  "name": "@go2asia/db",
  "version": "0.1.0",
  "private": true,
  "description": "Database schema and migrations for Go2Asia MVP (Drizzle ORM)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./queries/blog": "./src/queries/blog.ts",
    "./queries/cityMapping": "./src/queries/cityMapping.ts",
    "./queries/content": "./src/queries/content.ts",
    "./queries/guides": "./src/queries/guides.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit up:pg",
    "db:push": "drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio",
    "db:ddl:apply": "tsx src/ddlApply.ts",
    "db:ddl:apply:staging": "cross-env ENVIRONMENT=staging tsx src/ddlApply.ts",
    "db:ddl:apply:prod": "cross-env ENVIRONMENT=production tsx src/ddlApply.ts",
    "db:seed": "tsx src/seed.ts",
    "db:seed:content": "tsx src/seed.ts",
    "db:seed:pulse": "tsx src/seed.ts",
    "db:seed:space-saved-demo": "cross-env ENVIRONMENT=staging tsx src/seedSpaceSavedDemo.ts",
    "db:seed:atlas-tabs": "tsx src/seedAtlasTabs.ts",
    "db:seed:atlas-places-ph": "tsx src/seedAtlasPlacesPhilippines.ts",
    "db:seed:atlas-places-kh": "tsx src/seedAtlasPlacesCambodia.ts",
    "db:import:space-md": "cross-env ENVIRONMENT=staging tsx src/importSpaceSeedFromMarkdown.ts",
    "db:import:organizer-md": "cross-env ENVIRONMENT=staging tsx src/importOrganizerSeedFromMarkdown.ts",
    "db:cleanup:blog": "cross-env ENVIRONMENT=staging tsx src/cleanupBlogCanon.ts",
    "db:cleanup:demo-places": "tsx src/cleanupDemoPlaces.ts",
    "db:export:places-neon": "tsx src/exportPlacesToNeon.ts",
    "db:export:atlas-country-city-tabs-neon": "tsx src/exportAtlasCountryCityTabsToNeon.ts",
    "db:import:guides-md": "cross-env ENVIRONMENT=staging tsx src/importGuidesFromMarkdown.ts",
    "db:import:themes-md": "cross-env ENVIRONMENT=staging NODE_OPTIONS=--max-old-space-size=4096 tsx src/importGuidesFromMarkdown.ts --themes-only",
    "db:import:pulse-md": "cross-env ENVIRONMENT=staging tsx src/importPulseEventsFromMarkdown.ts",
    "db:import:rielt-core-csv": "cross-env ENVIRONMENT=staging tsx src/importRieltCoreFromCsv.ts",
    "db:sync:rielt-media-r2": "cross-env ENVIRONMENT=staging tsx src/syncRieltMediaFromR2.ts",
    "db:import:blog-md": "cross-env ENVIRONMENT=staging tsx src/importBlogFromMarkdown.ts",
    "db:verify:blog-canon": "cross-env ENVIRONMENT=staging tsx src/verifyBlogCanon.ts",
    "db:seed:connect-demo": "cross-env ENVIRONMENT=staging tsx src/seedConnectDemo.ts",
    "db:verify:connect-demo": "cross-env ENVIRONMENT=staging tsx src/verifyConnectDemo.ts",
    "db:seed:rf-paid-staging-offers": "cross-env ENVIRONMENT=staging tsx src/seedRfPaidStagingOffers.ts",
    "db:seed:vip-paid-voucher-validation-topup": "cross-env ENVIRONMENT=staging tsx src/seedVipPaidVoucherValidationTopup.ts",
    "db:city-mapping:pilot:preview": "cross-env ENVIRONMENT=staging tsx src/prepareCityMappingPilot.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "drizzle-orm": "^0.29.0",
    "pg": "^8.16.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@go2asia/config": "workspace:*",
    "@types/pg": "^8.16.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
